FROM node:24-alpine AS frontend

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY contracts/ ../contracts/
COPY frontend/ ./
RUN npm run api:check \
    && npm test -- --run --pool=forks --maxWorkers=1 \
    && npm run typecheck \
    && npm run build

FROM python:3.12-slim AS application

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    LABBRIDGE_FRONTEND_DIR=/app/frontend/dist

WORKDIR /app
COPY pyproject.toml README.md ./
RUN mkdir -p src/labbridge \
    && touch src/labbridge/__init__.py \
    && pip install --no-cache-dir . \
    && rm -rf src
COPY src/ ./src/
COPY alembic.ini ./
COPY migrations/ ./migrations/
COPY scripts/run_demo.sh scripts/check_demo_health.py ./scripts/
COPY --from=frontend /build/frontend/dist ./frontend/dist/

EXPOSE 8000
CMD ["sh", "scripts/run_demo.sh"]
