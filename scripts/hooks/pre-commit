#!/usr/bin/env bash
# LabBridge pre-commit gate. Enable with:  git config core.hooksPath scripts/hooks
#
# The fast local gate runs on every commit. Integration tests, migration tests, artifact validation,
# and container execution remain explicit higher-layer checks.
#
# Gates whose target does not exist yet are skipped explicitly and reported as [skip], never as passing.
set -uo pipefail

fail=0
have() { command -v "$1" >/dev/null 2>&1; }

for required_tool in git grep sed; do
  if ! have "$required_tool"; then
    echo "labbridge pre-commit: [FAIL] required tool missing ($required_tool)"
    exit 1
  fi
done

staged_all=""
staged_code=""
staged_docs=""
if have git; then
  staged_all=$(git diff --cached --name-only --diff-filter=ACMR || true)
  staged_code=$(printf '%s\n' "$staged_all" \
    | grep -E '^((src|tests|scripts)/|\.claude/(hooks|tools)/).*\.py$' || true)
  staged_docs=$(printf '%s\n' "$staged_all" \
    | grep -E '^(README|CONTRIBUTING|AGENTS|CLAUDE|AI_CONTRACT)\.md$|^docs/.*\.md$' || true)
fi

run() {  # run <label> <cmd...>; block on failure, or on a missing tool when code is staged
  local label="$1"; shift
  if ! have "$1"; then
    if [ -n "$staged_code" ]; then
      echo "  [FAIL] $label: required tool missing for a source commit ($1)"
      fail=1
    else
      echo "  [skip] $label ($1 not installed; no Python staged)"
    fi
    return 0
  fi
  echo "  [run ] $label"
  if ! "$@"; then echo "  [FAIL] $label"; fail=1; fi
}

echo "labbridge pre-commit:"

# --- forbidden files ---------------------------------------------------------------------------
# .gitignore is the first defence; this blocks a `git add -f` or an already-tracked slip.
if have git; then
  forbidden=$(printf '%s\n' "$staged_all" \
    | grep -iE '(^|/)\.env($|\.)|(^|/)[^/]*\.(pem|key|p12|pfx)$|(^|/)(id_rsa|id_ed25519)$|^data/(raw|her)/|^\.(claude|agents|codex)/(settings\.local\.json|logs/|state/)' || true)
  if [ -n "$forbidden" ]; then
    echo "  [FAIL] forbidden file(s) staged:"; printf '%s\n' "$forbidden" | sed 's/^/    - /'
    echo "         unstage with: git restore --staged <file>"
    fail=1
  fi
fi

# --- public documentation ------------------------------------------------------------------------
if [ -n "$staged_docs" ]; then
  if [ ! -f scripts/check_docs.py ]; then
    echo "  [FAIL] documentation: scripts/check_docs.py is missing"; fail=1
  elif ! have python; then
    echo "  [FAIL] documentation: python is required"; fail=1
  else
    run "documentation" python scripts/check_docs.py --strict
  fi
else
  echo "  [skip] documentation (no public Markdown staged)"
fi

# --- normative document manifest -----------------------------------------------------------------
staged_normative=$(printf '%s\n' "$staged_docs" \
  | grep -E '^(AGENTS|CLAUDE|AI_CONTRACT)\.md$|^docs/.*\.md$' || true)
if [ -n "$staged_normative" ]; then
  if have sha256sum; then
    echo "  [run ] document manifest"
    if ! sha256sum -c SHA256SUMS.txt >/dev/null 2>&1; then
      echo "  [FAIL] document manifest: a normative document is staged but SHA256SUMS.txt does not match."
      echo "         Regenerate it in this commit:"
      echo "           git ls-files -co --exclude-standard -- AGENTS.md AI_CONTRACT.md CLAUDE.md 'docs/*.md' \\"
      echo "             | xargs sha256sum > SHA256SUMS.txt"
      fail=1
    fi
  else
    echo "  [FAIL] document manifest: sha256sum missing, but a normative document is staged"; fail=1
  fi
else
  echo "  [skip] document manifest (no normative document staged)"
fi

# --- source quality gates -------------------------------------------------------------------------
if [ -n "$staged_code" ]; then
  # Pass only directories that exist: ruff exits 2 on a missing path, which would fail the gate
  # with an error unrelated to the change.
  lint_targets=""
  for d in src tests scripts migrations .claude/hooks .claude/tools; do
    [ -d "$d" ] && lint_targets="$lint_targets $d/"
  done
  # shellcheck disable=SC2086
  run "ruff format --check" ruff format --check $lint_targets
  # shellcheck disable=SC2086
  run "ruff check"          ruff check $lint_targets
  [ -d src ] && run "mypy --strict" mypy --strict src/ || echo "  [skip] mypy --strict (no src/ yet)"
  [ -d tests ] && run "pytest (offline)" pytest -q -m "not slow and not data and not integration" \
    || echo "  [skip] pytest (no tests/ yet)"
else
  echo "  [skip] source quality gates (no Python staged)"
fi

# --- artifact validation ----------------------------------------------------------------------------
# Run the checkout's own CLI rather than whatever `labbridge` resolves to on PATH: an editable
# install can point at a different worktree, which would gate this commit on another tree's bytes.
# This is the gate that must not be able to pass by not running, so resolve an interpreter under
# either common name rather than skipping on a platform where only `python3` exists.
python_bin=""
if have python; then
  python_bin=python
elif have python3; then
  python_bin=python3
fi
if [ -n "$python_bin" ] && [ -d src/labbridge ]; then
  # `src` first so an editable install pointing at another worktree cannot decide this commit.
  export PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}"
  run "artifact validation" "$python_bin" -m labbridge.cli validate-artifacts
else
  echo "  [skip] artifact validation (no python interpreter or no src/labbridge in this checkout)"
fi

# --- secret scan on staged content ------------------------------------------------------------------
# Hook scripts are excluded from their own scan because their detection literals would self-trigger.
if have git; then
  if git diff --cached -U0 -- . ':(exclude)scripts/hooks/*' \
      | grep -nE '(sk-[A-Za-z0-9]{20,}|ANTHROPIC_API_KEY=|AWS_SECRET_ACCESS_KEY=|MINIO_ROOT_PASSWORD=|POSTGRES_PASSWORD=|-----BEGIN [A-Z ]*PRIVATE KEY-----)'; then
    echo "  [FAIL] possible secret in the staged diff"; fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: BLOCKED. Fix the failures above."
  exit 1
fi
echo "pre-commit: OK"
echo "            Heavier gates (integration, migration, artifacts, compose) are not run here."
